# Copy this file to .env, replace every example credential, run chmod 600 .env,
# and never commit credentials. The non-secret placeholders make
# `docker compose --env-file .env.example config` independently verifiable.

# Production image tag. Use `latest` for normal upgrades or an immutable
# `sha-<12-character-commit>` tag for rollback.
HOME_GALLERY_IMAGE_TAG=latest

# Host ports. These defaults deliberately avoid the common 3000 through 3003
# range so Home Gallery can share a host with unrelated stacks.
HOME_GALLERY_GALLERY_PORT=3010
HOME_GALLERY_ADMIN_PORT=3011
HOME_GALLERY_API_PORT=3012

# Address that publishes the three plain-HTTP endpoints. Keep 0.0.0.0 for the
# trusted-LAN profile. The TLS profile requires 127.0.0.1 so it is the only
# externally reachable entry point.
HOME_GALLERY_HTTP_BIND_ADDRESS=0.0.0.0

# Host directory used by infra/backup.sh and infra/restore.sh.
HOME_GALLERY_BACKUP_DIR=./backups

# Optional supported public-TLS profile. Keep false for the simple trusted-LAN
# deployment. When true, deploy.sh adds docker-compose.tls.yml, binds the three
# plain-HTTP ports to loopback, and exposes Caddy on ports 80 and 443.
HOME_GALLERY_TLS_ENABLED=false
HOME_GALLERY_TLS_GALLERY_HOST=gallery.example.com
HOME_GALLERY_TLS_ADMIN_HOST=admin.gallery.example.com
HOME_GALLERY_TLS_HTTP_PORT=80
HOME_GALLERY_TLS_HTTPS_PORT=443

# --- Home Gallery server (apps/server) ---

# Required bearer credential for ingestion clients such as the Telegram bot.
# It must be at least 32 characters with no whitespace. Generate it with:
# openssl rand -hex 32
#
# Administration access is not configured here: the administration app starts
# without a password and the administrator sets one from its Security panel.
HOME_GALLERY_INGESTION_TOKEN=replace-with-a-random-64-character-ingestion-token

# Optional overlap credential used only during rotation. Set the old value as
# *_PREVIOUS, deploy the new primary value to clients, then remove the old one.
HOME_GALLERY_INGESTION_TOKEN_PREVIOUS=

# Optional. An administration session cannot use POST /api/media by default.
# Enable only when uploads from the administration UI are deliberately needed.
HOME_GALLERY_ALLOW_ADMIN_UPLOADS=false

# Optional browser administration sessions. The administration app creates a
# session, sending the administration password when one is set. Sessions are
# held only in server memory, expire after eight hours by default, and are
# capped at 64. Secure
# cookies are enabled automatically by the supported TLS Compose profile; keep
# false only for the trusted-LAN plain-HTTP profile.
HOME_GALLERY_ADMIN_SESSION_TTL_MS=28800000
HOME_GALLERY_ADMIN_SESSION_MAX=64
HOME_GALLERY_ADMIN_SESSION_SECURE=false

# Optional fixed-window limits. Authentication failures and authenticated media
# upload attempts are counted separately per proxy-aware client address.
HOME_GALLERY_AUTH_RATE_LIMIT_MAX=10
HOME_GALLERY_AUTH_RATE_LIMIT_WINDOW_MS=60000
HOME_GALLERY_UPLOAD_RATE_LIMIT_MAX=30
HOME_GALLERY_UPLOAD_RATE_LIMIT_WINDOW_MS=60000

# Optional. Comma-separated proxy IPs/CIDRs whose forwarding headers are trusted.
# Empty ignores all forwarded values. The TLS profile supplies its private
# Compose range alias automatically; never use a universal trust value.
HOME_GALLERY_TRUSTED_PROXIES=

# Required. Directory that holds the SQLite database and the normalized media.
# A relative value is resolved against the working directory.
HOME_GALLERY_DATA_DIR=./data

# Optional. Listening address and port. Defaults: 0.0.0.0 and 3012.
HOME_GALLERY_HOST=0.0.0.0
HOME_GALLERY_PORT=3012

# Optional. Upload limits. Defaults: 26214400 bytes (25 MiB) and 5000 files.
HOME_GALLERY_MAX_UPLOAD_BYTES=26214400
HOME_GALLERY_MAX_STORED_FILES=5000

# Optional. Comma-separated browser origins allowed to call the API. Empty means
# same-origin only. Use "*" on its own to allow every origin.
HOME_GALLERY_ALLOWED_ORIGINS=

# Optional. One of fatal, error, warn, info, debug, trace, silent. Default: info.
HOME_GALLERY_LOG_LEVEL=info

# Optional. Version reported by GET /health. Default: 0.0.0.
HOME_GALLERY_VERSION=

# --- Telegram ingestion bot (apps/telegram-bot) ---

# Required. Token issued by BotFather. Keep this value out of source control and
# logs.
HOME_GALLERY_TELEGRAM_BOT_TOKEN=123456789:replace_with_the_real_BotFather_token

# Required. Base URL the bot uses to reach the Home Gallery API.
HOME_GALLERY_API_URL=http://localhost:3012

# Optional. Timeout for Telegram and Home Gallery requests in milliseconds.
# Valid range: 1000 through 120000. Default: 30000.
HOME_GALLERY_TELEGRAM_REQUEST_TIMEOUT_MS=30000

# Optional. Maximum Telegram response buffered before upload. Keep this at or
# below HOME_GALLERY_MAX_UPLOAD_BYTES. Default: 26214400 bytes (25 MiB).
HOME_GALLERY_TELEGRAM_MAX_DOWNLOAD_BYTES=26214400
