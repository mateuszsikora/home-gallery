{
  "name": "home-gallery",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "compose:config": "docker compose --env-file .env.example config --quiet",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:compose": "bash scripts/compose-smoke.sh",
    "test:gallery:browser": "node scripts/gallery-browser-smoke.mjs",
    "test:tls-config": "bash scripts/tls-config-smoke.sh",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
